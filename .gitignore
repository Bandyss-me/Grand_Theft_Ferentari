# This .gitignore should be placed at root of your Unity project

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/

# Memory captures
MemoryCaptures/

# Asset meta data generated by Rider/VS
.idea/
.vscode/
.vs/

# Auto-generated solution/project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity cache
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# macOS
.DS_Store

# Windows
Thumbs.db

# Addressables / generated bundles
ServerData/

# Android
.gradle/

# JetBrains Rider
.idea/

# Visual Studio Code
.history/

# Generated builds
*.apk
*.aab
*.unitypackage